<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Chat.Protocol\Chat.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- M3-06：允许服务端单测访问 internal 成员（如 PresenceService.FindPeerUserIdsAsync），不影响运行时。 -->
    <InternalsVisibleTo Include="Chat.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- 密钥纪律（AGENTS §6）：本地 secrets.json（JWT 密钥/SMTP 凭据）只留在开发机，绝不能随发布包上线。 -->
    <Content Remove="secrets.json" />
    <None Remove="secrets.json" />
    <!-- 开发环境配置（Mock 验证码等）不发布到服务器/镜像。 -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- F-27：统一发布版本；/download 页面与健康检查展示的程序集版本来自此处。 -->
    <Version>1.2.0</Version>
    <!-- 镜像瘦身：服务端只用中文错误文案（代码内），不需要 .NET/EF 的多语言卫星资源。 -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
