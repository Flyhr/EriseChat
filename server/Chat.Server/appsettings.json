{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:8080"
      }
    }
  },
  "App": {
    "DataDirectory": "../../data",
    "FileDirectory": "../../data/files",
    "UploadMaxBytes": 52428800,
    "OrphanFileCleanupIntervalHours": 24,
    "RegistrationEnabled": true,
    "AllowedEmailDomains": [],
    "ProtocolVersion": 1,
    "GroupMaxMembers": 100,
    "GroupOnlyOwnerCanInvite": false
  },
  "Jwt": {
    "Issuer": "eisechat",
    "Audience": "eisechat",
    "ExpireDays": 7,
    "ClockSkewSeconds": 30
  },
  "Email": {
    "Mock": {
      "FixedCode": ""
    },
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUseSsl": true,
    "SmtpUser": "",
    "SmtpPassword": "",
    "FromAddress": "",
    "FromName": "EiseChat"
  },
  "RateLimit": {
    "EmailCodePerEmailIntervalSeconds": 60,
    "EmailCodePerEmailDaily": 10,
    "EmailCodePerIpHourly": 20,
    "EmailCodeMaxAttempts": 5,
    "LoginFailedMaxAttempts": 5,
    "LoginLockMinutes": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
