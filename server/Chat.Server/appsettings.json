{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:6580"
      }
    }
  },
  "App": {
    "DataDirectory": "../../data",
    "FileDirectory": "../../data/files",
    "DownloadDirectory": "../../data/downloads",
    "UploadMaxBytes": 52428800,
    "OrphanFileCleanupIntervalHours": 24,
    "RegistrationEnabled": true,
    "AllowedEmailDomains": [],
    "ProtocolVersion": 1,
    "GroupMaxMembers": 100,
    "GroupOnlyOwnerCanInvite": false,
    "MaxConnectionsPerUser": 3
  },
  "Jwt": {
    "Issuer": "erisechat",
    "Audience": "erisechat",
    "ExpireDays": 3,
    "ClockSkewSeconds": 30
  },
  "Email": {
    "Mock": {
      "FixedCode": ""
    },
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUseSsl": true,
    "SmtpUser": "",
    "SmtpPassword": "",
    "FromAddress": "",
    "FromName": "EriseChat"
  },
  "Call": {
    "Enabled": true,
    "RingTimeoutSeconds": 60,
    "DisconnectGraceSeconds": 10,
    "MaxDurationSeconds": 0
  },
  "RateLimit": {
    "EmailCodePerEmailIntervalSeconds": 60,
    "EmailCodePerEmailDaily": 10,
    "EmailCodePerIpHourly": 20,
    "EmailCodeMaxAttempts": 5,
    "LoginFailedMaxAttempts": 5,
    "LoginLockMinutes": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
