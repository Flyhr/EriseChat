{
  "name": "erisechat-desktop",
  "version": "1.2.0",
  "private": true,
  "description": "EriseChat Windows 桌面壳（Electron：窗口/托盘/通知/打包，业务逻辑在 apps/web）",
  "author": "EriseChat",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p electron/tsconfig.json",
    "build:web": "cd ../web && npm run build:file",
    "typecheck": "tsc -p electron/tsconfig.json --noEmit",
    "dist": "npm run build:web && npm run build && electron-builder --win nsis --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  }
}
