# EiseChat Docker 部署配置模板（复制为部署机上的 .env，权限 600）
# 说明：docker compose 通过 env_file 读取；其中值会作为环境变量注入容器。
# 注意：本文件只是模板，真实密钥请写在部署机的 /opt/eisechat/.env，不要提交仓库。
# 修改 .env 后必须重新执行 deploy.sh（或 docker compose up -d --force-recreate），
# 单纯 docker compose restart 不会重新读取 .env。

ASPNETCORE_ENVIRONMENT=Production

# JWT 签名密钥（HS256，至少 32 字节随机值；deploy.sh 首次部署会自动生成）
Jwt__Key=CHANGE_ME_32_BYTES_RANDOM_BASE64

# --- SMTP 邮件通道（生产必须配置，否则验证码发送失败）---
# 端口说明：用 587（STARTTLS）；465 是隐式 TLS，System.Net.Mail 不支持，会连接超时
Email__SmtpHost=smtp.qq.com
Email__SmtpPort=587
Email__SmtpUseSsl=true
Email__SmtpUser=CHANGE_ME@qq.com
Email__SmtpPassword=CHANGE_ME_SMTP_AUTH_CODE
Email__FromAddress=CHANGE_ME@qq.com
Email__FromName=EiseChat

# --- 可选业务配置（不填则用 appsettings.json 默认值）---
# App__RegistrationEnabled=true
# App__AllowedEmailDomains=example.com,company.com
# App__UploadMaxBytes=52428800
# App__GroupMaxMembers=100
# Jwt__ExpireDays=7
# RateLimit__EmailCodePerEmailIntervalSeconds=60
# RateLimit__EmailCodePerEmailDaily=10
# RateLimit__EmailCodePerIpHourly=20
